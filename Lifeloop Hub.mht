.hd h1 { color: var(--m); margin: 0px; font-size: 26px; font-weight: 700; letter-spacing: -0.5px; }

.hd p { margin: 2px 0px 0px; color: var(--mu); font-size: 12px; }

.tabs { position: sticky; top: env(safe-area-inset-top,0px); z-index: 9; display: flex; gap: 8px; overflow-x: auto; padding: 10px 16px; background: var(--bg); scrollbar-width: none; }

.tabs::-webkit-scrollbar { display: none; }

.tab { flex: 0 0 auto; border: 0px; border-radius: 99px; padding: 9px 14px; font: 600 13px Poppins, system-ui, sans-serif; background: var(--cd); color: var(--tx); box-shadow: 0 2px 0 var(--ln); }

.tab.on { background: var(--m); color: rgb(255, 255, 255); box-shadow: 0 8px 16px -8px var(--m); }

main { padding: 4px 16px 110px; }

.sm { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 6px 0px 14px; }

.sc { border-radius: 20px; padding: 12px 10px; color: rgb(61, 72, 87); min-height: 92px; display: flex; flex-direction: column; justify-content: space-between; gap: 4px; }

.sc:nth-child(1) { background: rgb(140, 157, 173); color: rgb(244, 239, 231); }

.sc:nth-child(2) { background: rgb(225, 231, 238); }

.sc:nth-child(3) { background: rgb(235, 227, 213); }

.eb { margin-bottom: 12px; }

.cdn { display: flex; justify-content: space-between; align-items: center; gap: 10px; background: var(--sb); color: rgb(244, 239, 231); border-radius: 18px; padding: 12px 14px; }

.cdn b { font-size: 13px; }

.cdn .qb { background: rgb(244, 239, 231); color: rgb(51, 65, 79); }

.sc span { font-size: 20px; }

.sc b { font-size: 16px; line-height: 1.15; word-break: break-word; }

.sc small { font-size: 10.5px; font-weight: 500; opacity: 0.8; line-height: 1.2; }

.sb2 { width: 100%; border: 1.5px solid var(--ln); background: var(--cd); color: var(--tx); border-radius: 16px; padding: 11px 14px; font-size: 14px; }

.ch { display: flex; gap: 8px; overflow-x: auto; padding: 10px 0px 12px; scrollbar-width: none; }

.ch::-webkit-scrollbar { display: none; }

.c1 { flex: 0 0 auto; border: 1.5px solid var(--ln); background: transparent; color: var(--tx); border-radius: 99px; padding: 6px 12px; font: 500 12px Poppins, sans-serif; }

.c1.on { background: var(--ms); border-color: var(--m); color: rgb(61, 72, 87); font-weight: 600; }

.g { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }

.g .ci { padding: 7px 8px 9px; }

.g .ci b { font-size: 11.5px; }

.g .ci small { font-size: 10px; }

.g .pl { font-size: 10.5px; padding: 6px 4px; }

.g .chip { font-size: 9px; padding: 2px 6px; }

.g .pos .chip { left: 5px; top: 5px; }

.l { display: grid; gap: 10px; }

.card { background: var(--cd); border-radius: 20px; box-shadow: 0 2px 0 var(--ln); overflow: hidden; cursor: pointer; transition: transform 0.15s; }

.card:active { transform: scale(0.98); }

.pos { position: relative; aspect-ratio: 3 / 4; background: var(--ms); }

.pos img { width: 100%; height: 100%; object-fit: cover; display: block; }

.ph { width: 100%; height: 100%; display: grid; place-items: center; }

.ph span { font-size: 34px; font-weight: 700; color: rgb(255, 255, 255); opacity: 0.9; }

.pos .chip { position: absolute; left: 8px; top: 8px; }

.chip { display: inline-block; border-radius: 99px; padding: 3px 9px; font-size: 10.5px; font-weight: 600; background: var(--ms); color: rgb(61, 72, 87); }

.ci { padding: 10px 12px 12px; display: grid; gap: 3px; }

.ci b { font-size: 13px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.ci small { color: var(--mu); font-size: 11.5px; }

.ci em { font-size: 11px; color: var(--mu); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.pl, .qb { border: 0px; border-radius: 12px; background: var(--m); color: rgb(255, 255, 255); font: 600 12px Poppins, sans-serif; padding: 7px 10px; margin-top: 4px; }

.qb { margin: 0px; }

.rw { padding: 14px; display: flex; gap: 12px; align-items: flex-start; }

